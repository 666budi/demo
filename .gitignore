# ============================================================
#  STM32 嵌入式工程 .gitignore 模板
#  覆盖：Keil MDK、STM32CubeIDE(Eclipse CDT)、STM32CubeMX、
#        GCC Makefile/CMake、VS Code、常用调试工具链
#
#  使用提示：
#   1. gitignore 中 # 只在【行首】才是注释，模式行末尾不能写注释
#   2. 已被跟踪的文件不受 .gitignore 影响！
#      漏网之鱼用： git rm -r --cached <路径> 取消跟踪后再提交
#   3. 排查"某文件为什么被忽略/没被忽略"：
#        git check-ignore -v <文件路径>
#   4. 个人机器专属规则（如某调试脚本）写进 .git/info/exclude，
#      效果等同 .gitignore 但不会进入仓库、不影响同事
#
#  铁律——以下文件【必须】纳入版本管理，勿加忽略：
#    *.ioc                      CubeMX 配置（相当于原理图的一部分）
#    *.uvprojx                  Keil 工程文件
#    *.cproject / *.project / *.mxproject   CubeIDE 工程定义
#    *.ld / 手写 *.sct          链接脚本（手写维护的）
#    启动文件 *.s、源码、README、.gitignore 本身
# ============================================================

# ------------------------------------------------------------
# 1. 操作系统垃圾文件
# ------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# Linux / 编辑器备份
*~
*.swp
*.swo
*.bak

# ------------------------------------------------------------
# 2. 通用编译产物（所有工具链）
#    固件 .hex/.bin/.elf 属于"构建输出"，发布归档走 GitHub
#    Release / 制品库，不进版本库（见教学方案 Day12）
# ------------------------------------------------------------
*.o
*.obj
*.d
*.i
*.su
*.lst
*.lss
*.map
*.axf
*.elf
*.hex
*.bin
*.s19
*.mot
*.build_log.html

# 常见输出目录名（Makefile / CMake / 手建 / VS）
build/
Build/
bin/
obj/
Obj/
out/
dist/
# CubeIDE 默认构建配置目录，以及 VS 的调试/发布目录
Debug/
Release/

# ------------------------------------------------------------
# 3. Keil MDK 专用
#    *.uvprojx 要提交；以下是随工程生成的"用户态/中间"文件
# ------------------------------------------------------------
# GUI 布局（带用户名，多人必冲突）
*.uvguix.*
*.uvgui.*
# 调试会话/断点/窗口状态
*.uvopt
*.uvoptx
# 调试器(DAP)机器相关配置
*.dbgconf
# MDK 默认输出与中间目录
Objects/
Listings/
# 编译/链接中间件
*.dep
*.crf
*.lnp
*.iex
*.omf
*.sdu
*.smy
*.tra
*.htm
*.o.*
# ★散列加载文件：在 Keil Dialog 里自动生成 → 忽略；
#   若你在工程目录手写维护 .sct，请删掉下一行！
*.sct
# 逻辑分析仪/仿真用户数据
*.stgroup

# ------------------------------------------------------------
# 4. STM32CubeIDE / Eclipse CDT
# ------------------------------------------------------------
# 工作区元数据
.metadata/
# Eclipse 用户偏好目录：
# ★团队若要共享 code formatter，删掉 .settings/ 这行，改用：
#   .settings/org.eclipse.cdt.*
#   .settings/org.eclipse.jdt.*
.settings/
# CubeIDE 生成的工程备份
*.cproject.bak
*.project.bak
*.ioc.bak

# ------------------------------------------------------------
# 5. STM32CubeMX
#    基本无需忽略（.ioc 必须提交）；只挡自动备份件。
#    注意：CubeMX 重新生成的 *_config.h / *_init.c 是【源码】，
#    要连同 .ioc 一起提交，保证"配置 ↔ 代码"一致可追溯。
# ------------------------------------------------------------
*.ioc~
*_Backup*.ioc

# ------------------------------------------------------------
# 6. GCC / Makefile / CMake
# ------------------------------------------------------------
# CMake 缓存与生成物
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
cmake-build-*/
CMakeLists.txt.user*
# IDE 索引用的编译数据库（由 CMake -DCMAKE_EXPORT_COMPILE_COMMANDS 生成）
compile_commands.json
# 手写的交叉编译工具链文件必须保留（示例放行）
*.cmake
!toolchain/*.cmake
!scripts/**/*.cmake
# Ninja
.ninja_deps
.ninja_log
build.ninja
# 链接产物
*.a
*.lib
*.so
# GDB 脚本与调试符号包（手写 .gdbinit 团队共享则放行）
*.gdb
.gdbinit
*.dSYM/
# 测试与覆盖率
coverage/
*.gcno
*.gcda
*.gcov
*.profraw
*.profdata

# ------------------------------------------------------------
# 7. VS Code
# ------------------------------------------------------------
# 方案 A（推荐新手）：整个 .vscode 不进仓库
.vscode/

# 方案 B（团队共享任务/调试配置时）：注释掉方案 A 那行，放开下面 5 行
# .vscode/*
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/extensions.json

# 本地扩展工程（如用 EIDE 插件）
.eide/
# ------------------------------------------------------------
# 8. clangd / 代码智能提示（本机索引，不入库）
# ------------------------------------------------------------
.cache/
.clangd/

# ------------------------------------------------------------
# 9. 调试器 / 烧录工具链
# ------------------------------------------------------------
# J-Link
*.jlink
JLinkLog.txt
JLinkSettings.ini
jlink*.log
*.jls
# OpenOCD：生成的日志忽略；手写的板级 *.cfg 必须提交！
openocd.log
# pyOCD / ST-Link 编程器状态
.pyocd/
*.stproj

# ------------------------------------------------------------
# 10. Python 上位机 / 测试脚本（如工程内带 tools/）
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
# 本地环境变量文件（常含密码，必须忽略；提交 .env.example 模板）
.env

# ------------------------------------------------------------
# 11. 大文件 / 数据（建议 >1MB 的测试数据走 Git LFS 而非入库，
#     见教程 §7.2；以下按需取消注释）
# ------------------------------------------------------------
# *.csv
# *.dat
test_data/
firmware_images/

# ------------------------------------------------------------
# 12. 密钥与安全（红线！）
#     约定：仓库只提交 *.example.h / *_example 模板，
#     真实凭据永远放本地未跟踪的同名文件。
#     注意：密钥一旦进过 Git 历史 = 已泄露，先吊销再清历史！
# ------------------------------------------------------------
secrets/
*.key
*.pem
*.p12
*.pfx
*_secret.h
wifi_secrets.h
*_local.h
config_local.h
# 放行模板文件示例
!wifi_secrets.example.h

# ------------------------------------------------------------
# 13. 日志与临时
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp

# ------------------------------------------------------------
# 14. 反忽略示例（被通配误伤时的 ! 放行写法）
# ------------------------------------------------------------
# 例如第 6 节的 *.a 会误伤名为 libxxx.a 的必须提交的闭源库：
# 应改用 LFS 管理并精确路径放行：
# !lib/vendor/libxxx.a
# 例如团队约定文档入库：
# !docs/**
